{
  "name": "vue-laravel-datatable",
  "version": "1.0.0",
  "description": "yajra datatables for laravel with novinvision/laravel-datatable package",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css",
    "./components/*": {
      "import": "./dist/components/*/index.js",
      "types": "./dist/components/*/index.d.ts"
    },
    "./src/*.css": {
      "import": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "src",
    "index.d.ts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "keywords": [
    "vue",
    "laravel",
    "yajra datatables",
    "datatable",
    "inertia",
    "bootstrap components",
    "bootstrap"
  ],
  "author": "NovinVision",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novinvision/vue-laravel-datatable.git"
  },
  "homepage": "https://github.com/novinvision/vue-laravel-datatable#readme",
  "dependencies": {
    "datatables.net-bs5": "^2.0.5",
    "datatables.net-buttons": "^3.0.2",
    "datatables.net-buttons-bs5": "^3.0.2",
    "datatables.net-fixedcolumns-bs5": "^5.0.0",
    "datatables.net-fixedheader-bs5": "^4.0.1",
    "datatables.net-responsive-bs5": "^3.0.2",
    "datatables.net-searchbuilder-bs5": "^1.7.1",
    "datatables.net-searchpanes": "^2.3.0",
    "datatables.net-searchpanes-bs5": "^2.3.0",
    "datatables.net-select": "^2.0.1",
    "datatables.net-select-bs5": "^2.0.1",
    "datatables.net-select-dt": "^2.0.1",
    "datatables.net-vue3": "^3.0.1"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "@inertiajs/vue3": "^3.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "bugs": {
    "url": "https://github.com/novinvision/vue-laravel-datatable/issues"
  }
}
